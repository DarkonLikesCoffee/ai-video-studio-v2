{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-video-studio.local/schemas/creative-brief.schema.json",
  "title": "AI Video Studio Creative Brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "sourcePrompt",
    "objective",
    "audience",
    "desiredResponse",
    "delivery",
    "creativeThesis",
    "emotionalArc",
    "visualLanguage",
    "storytellingStrategy",
    "motionLanguage",
    "soundIdentity",
    "productionMethodStrategy",
    "constraints",
    "assumptions",
    "acceptanceCriteria"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "sourcePrompt": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "desiredResponse": {
      "type": "string",
      "minLength": 1
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "durationSeconds",
        "width",
        "height",
        "fps",
        "format",
        "platform",
        "language"
      ],
      "properties": {
        "durationSeconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 300
        },
        "width": {
          "type": "integer",
          "minimum": 320,
          "maximum": 7680
        },
        "height": {
          "type": "integer",
          "minimum": 320,
          "maximum": 4320
        },
        "fps": {
          "enum": [
            24,
            25,
            30,
            50,
            60
          ]
        },
        "format": {
          "const": "mp4"
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "creativeThesis": {
      "type": "string",
      "minLength": 1
    },
    "emotionalArc": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "visualLanguage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "palette",
        "typography",
        "composition",
        "lighting",
        "texture"
      ],
      "properties": {
        "palette": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "typography": {
          "type": "string",
          "minLength": 1
        },
        "composition": {
          "type": "string",
          "minLength": 1
        },
        "lighting": {
          "type": "string",
          "minLength": 1
        },
        "texture": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "storytellingStrategy": {
      "type": "string",
      "minLength": 1
    },
    "motionLanguage": {
      "type": "string",
      "minLength": 1
    },
    "soundIdentity": {
      "type": "string",
      "minLength": 1
    },
    "productionMethodStrategy": {
      "type": "string",
      "minLength": 1
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 3,
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
