{
  "schemaVersion": 1,
  "id": "sora-product-film",
  "title": "SORA — Sound, shaped around you",
  "description": "A 12-second fictional premium headphone product film. Four distinct original vector compositions move from macro material to silhouette, interface detail and final hero.",
  "composition": {
    "id": "ProjectVideo",
    "width": 1920,
    "height": 1080,
    "fps": 30
  },
  "scenes": [
    {
      "id": "material",
      "type": "content",
      "durationInFrames": 90,
      "backgroundColor": "#090d0d",
      "accentColor": "#d56a42",
      "mediaLayers": [
        {
          "id": "macro-artwork",
          "type": "image",
          "src": "assets/01-material.svg",
          "x": 0,
          "y": 0,
          "width": 100,
          "height": 100,
          "fit": "cover",
          "zIndex": 0,
          "animations": {
            "scaleX": {
              "keyframes": [
                {
                  "frame": 0,
                  "value": 1.08,
                  "easing": "ease-out"
                },
                {
                  "frame": 89,
                  "value": 1
                }
              ]
            },
            "scaleY": {
              "keyframes": [
                {
                  "frame": 0,
                  "value": 1.08,
                  "easing": "ease-out"
                },
                {
                  "frame": 89,
                  "value": 1
                }
              ]
            },
            "x": {
              "keyframes": [
                {
                  "frame": 0,
                  "value": 2
                },
                {
                  "frame": 89,
                  "value": -1
                }
              ]
            }
          }
        }
      ],
      "title": "ENGINEERED TO DISAPPEAR.",
      "eyebrow": "SORA / MATERIAL STUDY"
    },
    {
      "id": "silhouette",
      "type": "content",
      "durationInFrames": 90,
      "transitionIn": {
        "type": "cut",
        "durationInFrames": 0
      },
      "backgroundColor": "#eee8dd",
      "accentColor": "#c55e3c",
      "mediaLayers": [
        {
          "id": "silhouette-artwork",
          "type": "image",
          "src": "assets/02-silhouette.svg",
          "x": 0,
          "y": 0,
          "width": 100,
          "height": 100,
          "fit": "cover",
          "zIndex": 0,
          "animations": {
            "scaleX": {
              "keyframes": [
                {
                  "frame": 0,
                  "value": 1.04
                },
                {
                  "frame": 89,
                  "value": 1
                }
              ]
            },
            "scaleY": {
              "keyframes": [
                {
                  "frame": 0,
                  "value": 1.04
                },
                {
                  "frame": 89,
                  "value": 1
                }
              ]
            },
            "x": {
              "keyframes": [
                {
                  "frame": 0,
                  "value": -1
                },
                {
                  "frame": 89,
                  "value": 1
                }
              ]
            }
          }
        }
      ],
      "title": "SORA — SOUND, SHAPED AROUND YOU.",
      "eyebrow": "SORA / FORM STUDY"
    },
    {
      "id": "control",
      "type": "content",
      "durationInFrames": 90,
      "transitionIn": {
        "type": "cut",
        "durationInFrames": 0
      },
      "backgroundColor": "#171918",
      "accentColor": "#d56a42",
      "mediaLayers": [
        {
          "id": "detail-artwork",
          "type": "image",
          "src": "assets/03-detail.svg",
          "x": 0,
          "y": 0,
          "width": 100,
          "height": 100,
          "fit": "cover",
          "zIndex": 0,
          "animations": {
            "scaleX": {
              "keyframes": [
                {
                  "frame": 0,
                  "value": 1.1,
                  "easing": "ease-out"
                },
                {
                  "frame": 89,
                  "value": 1
                }
              ]
            },
            "scaleY": {
              "keyframes": [
                {
                  "frame": 0,
                  "value": 1.1,
                  "easing": "ease-out"
                },
                {
                  "frame": 89,
                  "value": 1
                }
              ]
            },
            "x": {
              "keyframes": [
                {
                  "frame": 0,
                  "value": 1
                },
                {
                  "frame": 89,
                  "value": -1
                }
              ]
            }
          }
        }
      ],
      "title": "EVERY DETAIL, CONSIDERED.",
      "eyebrow": "SORA / DETAIL STUDY"
    },
    {
      "id": "hero",
      "type": "outro",
      "durationInFrames": 90,
      "transitionIn": {
        "type": "cut",
        "durationInFrames": 0
      },
      "backgroundColor": "#0c100f",
      "accentColor": "#d56a42",
      "mediaLayers": [
        {
          "id": "hero-artwork",
          "type": "image",
          "src": "assets/04-hero.svg",
          "x": 0,
          "y": 0,
          "width": 100,
          "height": 100,
          "fit": "cover",
          "zIndex": 0,
          "animations": {
            "scaleX": {
              "keyframes": [
                {
                  "frame": 0,
                  "value": 1.05,
                  "easing": "ease-out"
                },
                {
                  "frame": 75,
                  "value": 1
                }
              ]
            },
            "scaleY": {
              "keyframes": [
                {
                  "frame": 0,
                  "value": 1.05,
                  "easing": "ease-out"
                },
                {
                  "frame": 75,
                  "value": 1
                }
              ]
            }
          }
        }
      ],
      "title": "SORA — LISTEN CLOSER.",
      "eyebrow": "SORA / THE FULL FORM"
    }
  ],
  "output": {
    "format": "mp4",
    "codec": "h264"
  },
  "audioTracks": [
    {
      "id": "sora-original-score",
      "role": "music",
      "src": "assets/audio/score.wav",
      "startInFrames": 0,
      "durationInFrames": 360,
      "volume": 0.48,
      "fadeInFrames": 30,
      "fadeOutFrames": 45,
      "loop": false,
      "preservePitch": true,
      "effects": {
        "highPassHz": 38,
        "lowPassHz": 15000,
        "eqBands": [
          {
            "frequency": 120,
            "gainDb": 1.2,
            "q": 0.8
          },
          {
            "frequency": 3200,
            "gainDb": 1.1,
            "q": 1
          }
        ],
        "compressor": {
          "thresholdDb": -25,
          "ratio": 2,
          "attackMs": 28,
          "releaseMs": 260,
          "makeupGainDb": 0.8
        },
        "pan": 0
      }
    }
  ]
}
